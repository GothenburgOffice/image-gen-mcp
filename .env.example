# Copy to .env next to compose.images.yaml and fill in. This server holds NO provider keys:
# every client sends its own (X-OpenRouter-Key, X-LLMGateway-Key, X-Requesty-Key).

# The public origin (HTTPS, no trailing slash) and its host name: used for result URLs and
# for the DNS-rebinding Host check.
PUBLIC_URL=https://imagemcp.example.com
PUBLIC_HOST=imagemcp.example.com
APP_PORT=3430
# Set only when a reverse proxy overwrites this header (Caddy: header_up X-Real-IP {remote_host}).
TRUSTED_IP_HEADER=X-Real-IP
# Optional: also require "Authorization: Bearer <token>" on /mcp and /upload. Empty = open
# (callers still pay with their own keys).
SERVER_TOKEN=
# How long result and upload files are kept.
FILE_TTL_HOURS=168
# Paid calls (generate_image, generate_video, upload) per client IP.
RATE_PER_MINUTE=20
RATE_PER_DAY=500
# Written by update.sh: the pinned image.
IMAGE_GEN_MCP_IMAGE=
